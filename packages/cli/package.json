{
  "name": "@archivault/cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "archivault": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --external:better-sqlite3 --external:pg --sourcemap",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --external:better-sqlite3 --external:pg --sourcemap --watch",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "ora": "^5.4.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@archivault/core": "*",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}

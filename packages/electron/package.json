{
  "name": "@archivault/electron",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run build:renderer",
    "build:renderer": "vite build",
    "dev": "concurrently \"tsc --watch\" \"vite\" \"wait-on dist/main.js && electron .\"",
    "rebuild": "node scripts/rebuild-native.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@archivault/core": "*",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.25.0",
    "@tanstack/vue-query": "^5.101.4",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.archivault.app",
    "productName": "S3 Sync",
    "files": [
      "dist/**/*",
      "src/renderer/index.html"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

{
  "name": "@archivault/electron",
  "version": "1.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/muftring/archivault.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run build:renderer",
    "build:renderer": "vite build",
    "dev": "concurrently \"tsc --watch\" \"vite\" \"wait-on dist/main.js && electron .\"",
    "rebuild": "node scripts/rebuild-native.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@archivault/core": "*",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.25.0",
    "@tanstack/vue-query": "^5.101.4",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-icon-builder": "^2.0.1",
    "postcss": "^8.5.21",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.archivault.app",
    "productName": "Archivault",
    "electronVersion": "31.7.7",
    "files": [
      "dist/**/*",
      "src/renderer/index.html"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "muftring",
      "repo": "archivault"
    }
  }
}
